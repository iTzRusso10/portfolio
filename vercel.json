{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build && cp public/siti/index.html docs/index.html",
  "outputDirectory": "docs",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pricing",
      "destination": "/#prezzo",
      "permanent": true
    },
    {
      "source": "/pricing/:path*",
      "destination": "/#prezzo",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/projects/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/#chi-sono",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/#contatti",
      "permanent": true
    },
    {
      "source": "/contatti",
      "destination": "/#contatti",
      "permanent": true
    },
    {
      "source": "/portfolio",
      "destination": "/",
      "permanent": false
    }
  ]
}
